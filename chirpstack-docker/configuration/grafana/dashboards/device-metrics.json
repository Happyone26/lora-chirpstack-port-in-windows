{
  "title": "ChirpStack - Dados de Medição (RSSI/SNR/PDR/Throughput/Logs)",
  "uid": "chirpstack-device-metrics",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 8,
      "type": "state-timeline",
      "title": "Estado dos EDs (Standby / SF em que está medindo)",
      "description": "Cinza = standby (só consultas a cada ~10 s). Cor = medindo naquele SF. Vazio = sem nenhum frame por 45 s (desligado/sem join).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Standby",
                  "color": "#8a8a8a",
                  "index": 0
                },
                "7": {
                  "text": "SF7",
                  "color": "green",
                  "index": 1
                },
                "8": {
                  "text": "SF8",
                  "color": "yellow",
                  "index": 2
                },
                "9": {
                  "text": "SF9",
                  "color": "orange",
                  "index": 3
                },
                "10": {
                  "text": "SF10",
                  "color": "red",
                  "index": 4
                },
                "11": {
                  "text": "SF11",
                  "color": "purple",
                  "index": 5
                },
                "12": {
                  "text": "SF12",
                  "color": "dark-purple",
                  "index": 6
                }
              }
            }
          ],
          "color": {
            "mode": "fixed",
            "fixedColor": "#8a8a8a"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "alignValue": "left",
        "rowHeight": 0.9,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "chirpstack_device_mode * chirpstack_device_current_sf",
          "legendFormat": "{{device_name}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "EDs conectados agora",
      "description": "Inclui EDs em standby. Some da lista o ED sem nenhum frame por 45 s. Bateria (mV) vem das consultas de standby; Bateria (%) também dos dados.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "chirpstack_device_mode * chirpstack_device_current_sf",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - chirpstack_device_last_frame_timestamp_seconds",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "chirpstack_device_last_frame_rssi_dbm",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "chirpstack_device_last_frame_snr_db",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "chirpstack_device_battery_percent",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "chirpstack_device_battery_mv",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "G",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "chirpstack_device_usb_powered",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "device_id": true
            },
            "indexByName": {
              "device_name": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5,
              "Value #F": 6,
              "Value #G": 7
            },
            "renameByName": {
              "device_name": "ED",
              "Value #A": "Estado",
              "Value #B": "Último frame (s atrás)",
              "Value #C": "RSSI (dBm)",
              "Value #D": "SNR (dB)",
              "Value #E": "Bateria (%)",
              "Value #F": "Bateria (mV)",
              "Value #G": "Alimentação"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "ED"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Estado"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Standby",
                        "color": "#8a8a8a",
                        "index": 0
                      },
                      "7": {
                        "text": "SF7",
                        "color": "green",
                        "index": 1
                      },
                      "8": {
                        "text": "SF8",
                        "color": "yellow",
                        "index": 2
                      },
                      "9": {
                        "text": "SF9",
                        "color": "orange",
                        "index": 3
                      },
                      "10": {
                        "text": "SF10",
                        "color": "red",
                        "index": 4
                      },
                      "11": {
                        "text": "SF11",
                        "color": "purple",
                        "index": 5
                      },
                      "12": {
                        "text": "SF12",
                        "color": "dark-purple",
                        "index": 6
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Último frame (s atrás)"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Alimentação"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Bateria",
                        "color": "green",
                        "index": 0
                      },
                      "1": {
                        "text": "USB",
                        "color": "blue",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Bateria (%)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 20
                    },
                    {
                      "color": "green",
                      "value": 50
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Bateria (mV)"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 1,
      "title": "RSSI (dBm)",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "none",
            "spanNulls": true,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["last", "min", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "chirpstack_device_rssi_dbm",
          "legendFormat": "{{device_name}} ({{device_id}}) @ {{gateway_id}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "SNR (dB)",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "none",
            "spanNulls": true,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["last", "min", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "chirpstack_device_snr_db",
          "legendFormat": "{{device_name}} ({{device_id}}) @ {{gateway_id}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "PDR no período selecionado (%)",
      "description": "Recebidos / (recebidos + perdidos por buraco de FCnt) dentro do intervalo de tempo escolhido no Grafana. Para ver uma leitura antiga, selecione o horário dela.",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 90 },
              { "color": "green", "value": 98 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * sum by (device_name) (increase(chirpstack_device_uplink_frames_total[$__range])) / (sum by (device_name) (increase(chirpstack_device_uplink_frames_total[$__range])) + sum by (device_name) (increase(chirpstack_device_fcnt_gap_total[$__range])))",
          "legendFormat": "{{device_name}}",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "title": "Vazao de uplink (bytes/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 25,
            "gradientMode": "none",
            "spanNulls": true,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["last", "mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(chirpstack_device_uplink_bytes_total[$__rate_interval])",
          "legendFormat": "{{device_name}} ({{device_id}})"
        }
      ]
    },
    {
      "id": 6,
      "title": "Taxa de colisao estimada (Pure ALOHA, %)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 26 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 15,
            "gradientMode": "none",
            "spanNulls": true,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["last", "mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "chirpstack_device_collision_rate_percent",
          "legendFormat": "{{device_name}} ({{device_id}})"
        }
      ]
    },
    {
      "id": 7,
      "title": "Devices ativos (máximo no período)",
      "description": "Maior número de devices transmitindo ao mesmo tempo dentro do intervalo de tempo escolhido no Grafana.",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 26 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max_over_time(chirpstack_active_devices[$__range])",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Uplink log / payload",
      "type": "logs",
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 34 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{compose_service=\"mqtt-stats-exporter\"} | json"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Bateria (%)",
      "description": "Nível informado pelo firmware (dados e consultas de standby). Sem valor quando o ED está no USB.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "custom": {
            "lineWidth": 2,
            "spanNulls": true,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "chirpstack_device_battery_percent and on (device_id) (chirpstack_device_usb_powered == 0)",
          "legendFormat": "{{device_name}}"
        }
      ]
    }
  ]
}
